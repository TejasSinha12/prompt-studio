# Prompt Studio configuration. Copy to `.env` and adjust; `npm run dev` / `npm start`
# load PROMPT_STUDIO_* variables from it. No API keys are needed — none are supported.

# Where the SQLite database and backups are stored (default: ./data)
# PROMPT_STUDIO_DATA_DIR=/absolute/path/to/data

# Ports (always bound to 127.0.0.1)
# PROMPT_STUDIO_API_PORT=8000
# PROMPT_STUDIO_WEB_PORT=3000

# Default Ollama endpoint (can also be changed in Settings). Must be loopback unless
# you explicitly allow a remote endpoint in Settings.
# PROMPT_STUDIO_OLLAMA_URL=http://127.0.0.1:11434

# Optional shared secret required by the API for every request except /api/health.
# Protects against other local processes/users calling the API. The Next.js proxy adds it
# server-side; it is never sent to the browser. Use a long random value.
# PROMPT_STUDIO_API_TOKEN=

# Request body limits in bytes
# PROMPT_STUDIO_MAX_BODY_BYTES=2097152
# PROMPT_STUDIO_MAX_IMPORT_BYTES=10485760
